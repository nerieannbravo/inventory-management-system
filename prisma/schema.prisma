// Crush ako ni Nerie Ann.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Item {
  id          Int      @id @default(autoincrement())
  item_id      String   @unique @db.VarChar(20)
  item_name     String   @db.VarChar(100)
  unit_id       Int
  category_id   Int   
  status        ItemStatus @default(ACTIVE)
  description  String?  @db.VarChar(255)
  date_created  DateTime @default(now())
  date_updated  DateTime @updatedAt
  isdeleted     Boolean  @default(false)
  suppliers    SupplierItem[]

  unit         UnitMeasure @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  category     Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@map("items")
}

model Supplier {
  id          Int      @id @default(autoincrement())
  supplier_id   String   @unique @db.VarChar(20)
  supplier_name String   @db.VarChar(100)
  contact_number String  @db.VarChar(15)
  email         String?  @db.VarChar(100)
  street       String?  @db.VarChar(255)
  barangay     String?  @db.VarChar(100)
  city         String?  @db.VarChar(100)
  province     String?  @db.VarChar(100)
  status        SupplierStatus @default(ACTIVE)
  remarks      String?  @db.VarChar(255)
  date_created  DateTime @default(now())
  date_updated  DateTime @updatedAt
  isdeleted     Boolean  @default(false)
  items         SupplierItem[]

  @@map("suppliers")
}

model SupplierItem {
  supplier_id       Int
  item_id          Int
  unit_id          Int
  unit_price            Float   @default(0)
  delivery_time    String  @db.VarChar(50)
  note             String?  @db.VarChar(255)
  is_preferred     Boolean  @default(false)
  date_created     DateTime @default(now())
  date_updated     DateTime @updatedAt
  isdeleted        Boolean  @default(false)

  supplier         Supplier @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  unit UnitMeasure @relation("SupplierUnit", fields: [unit_id], references: [id], onDelete: Cascade)

  @@unique([supplier_id, item_id])
  @@index([unit_id])
  @@map("supplier_items")
}

model UnitMeasure {
  id                    Int              @id @default(autoincrement())
  unit_id                String           @unique @db.VarChar(20) // e.g., UNIT-001
  unit_name              String           @unique @db.VarChar(50) // pcs, liters, kg, etc.
  abbreviation          String           @unique @db.VarChar(10) // pcs, L, kg, etc.
  description           String?          @db.Text
  is_deleted             Boolean          @default(false)
  date_created             DateTime         @default(now())
  date_updated             DateTime         @updatedAt

  // Relations
  items                 Item[]
  supplierItems        SupplierItem[]   @relation("SupplierUnit")

  @@map("unit_measures")
}

model InventoryItem {
  item_id       String          @id @db.VarChar(20)
  category_id   String
  item_name     String          @db.VarChar(100)
  unit_measure  String          @db.VarChar(20)
  current_stock Int             @default(0)
  reorder_level Int             @default(0)
  status        InventoryStatus
  date_created  DateTime        @default(now())
  date_updated  DateTime        @updatedAt
  isdeleted     Boolean         @default(false)
  created_by    String
  batches       Batch[]
  employeeRequests EmployeeRequest[]
  bus           Bus[]
  stockDisposals StockDisposal[]
  category      Category        @relation(fields: [category_id], references: [category_id])
 
  @@map("inventory_items")
}

model Batch {
  batch_id           String        @id @db.VarChar(20)
  item_id            String
  f_item_id          String        @db.VarChar(20)
  usable_quantity    Int           @default(0)
  defective_quantity Int           @default(0)
  missing_quantity   Int           @default(0)
  remarks            String?       @db.VarChar(255)
  expiration_date    DateTime?
  date_created       DateTime      @default(now())
  created_by         String
  isdeleted          Boolean       @default(false)
  inventoryItem      InventoryItem @relation(fields: [item_id], references: [item_id])

  @@map("batches")
}

model Category {
  id            Int             @id @default(autoincrement())
  category_id    String          @unique @db.VarChar(20)
  category_name  String          @unique @db.VarChar(100)
  category_description String?   @db.VarChar(255)
  date_created   DateTime        @default(now())
  date_updated   DateTime        @updatedAt
  isdeleted      Boolean         @default(false)
  inventoryItems InventoryItem[]
  items         Item[]

  @@map("categories")
}

model EmployeeRequest {
  request_id    String          @id @db.VarChar(20)
  item_id       String            
  emp_id        String          @db.VarChar(20)
  request_type  RequestType     
  quantity      Int
  req_purpose   String          @db.VarChar(255)
  status        RequestStatus   
  expected_return_date DateTime?
  actual_return_date DateTime?
  date_created  DateTime        @default(now())
  date_updated  DateTime        @updatedAt
  isdeleted     Boolean         @default(false)
  created_by    Int
  inventoryItem InventoryItem   @relation(fields: [item_id], references: [item_id])

  @@map("employee_requests")
}

model Bus {
  bus_id          String          @id @db.VarChar(20)
  item_id         String
  plate_number    String          @unique
  body_number     String          @unique @db.VarChar(20)
  body_builder    BodyBuilder
  bus_type        BusType
  manufacturer    String
  status          BusStatus
  chasis_number   String          @unique @db.VarChar(50)
  engine_number   String          @unique @db.VarChar(50)
  seat_capacity   Int
  model           String          @db.VarChar(50)
  year_model      Int
  route           String?          @db.VarChar(10)
  condition       BusCondition
  acquisition_date DateTime
  acquisition_method AcquisitionMethod
  warranty_expiration_date DateTime?
  registration_status  RegistrationStatus
  date_created    DateTime        @default(now())
  date_updated    DateTime        @updatedAt
  created_by      Int
  inventoryItem   InventoryItem   @relation(fields: [item_id], references: [item_id])

  secondHandDetails     SecondHandDetails?
  brandNewDetails       BrandNewDetails?
  busOtherFiles         BusOtherFiles[]
  busDisposals          BusDisposal[]

  @@map("bus")
}

model SecondHandDetails {
  s_bus_id               String    @id
  previous_owner         String
  previous_owner_contact String
  source                 BusSource
  odometer_reading       Int
  last_registration_date DateTime
  last_maintenance_date  DateTime
  bus_condition_notes    String?

  bus                    Bus    @relation(fields: [s_bus_id], references: [bus_id], onDelete: Cascade)
}

model BrandNewDetails {
  b_bus_id        String    @id
  dealer_name     String
  dealer_contact  String

  bus             Bus    @relation(fields: [b_bus_id], references: [bus_id], onDelete: Cascade)
}

model BusOtherFiles {
  bus_files_id    String    @id @db.VarChar(20)
  file_name       String
  file_type       String
  file_url       String
  date_uploaded   DateTime @default(now())

  bus_id          String
  bus             Bus    @relation(fields: [bus_id], references: [bus_id], onDelete: Cascade)

@@map("bus_other_files")
}

model BusDisposal {
  disposal_id       String           @id @db.VarChar(20)
  bus_id            String
  disposal_date     DateTime
  disposal_method   DisposalMethod
  reason            String           @db.Text
  estimated_value   Float?
  actual_value      Float?
  disposal_status   DisposalStatus   @default(PENDING)
  approved_by       String?          @db.VarChar(20)
  approved_date     DateTime?
  remarks           String?          @db.Text
  date_created      DateTime         @default(now())
  date_updated      DateTime         @updatedAt
  created_by        String           @db.VarChar(20)
  isdeleted         Boolean          @default(false)
  
  bus               Bus              @relation(fields: [bus_id], references: [bus_id], onDelete: Cascade)

  @@map("bus_disposals")
}

model StockDisposal {
  disposal_id       String           @id @db.VarChar(20)
  item_id           String
  batch_id          String?          @db.VarChar(20)
  quantity          Int
  disposal_date     DateTime
  disposal_method   DisposalMethod
  reason            String           @db.Text
  estimated_value   Float?
  actual_value      Float?
  disposal_status   DisposalStatus   @default(PENDING)
  approved_by       String?          @db.VarChar(20)
  approved_date     DateTime?
  remarks           String?          @db.Text
  date_created      DateTime         @default(now())
  date_updated      DateTime         @updatedAt
  created_by        String           @db.VarChar(20)
  isdeleted         Boolean          @default(false)
  
  inventoryItem     InventoryItem    @relation(fields: [item_id], references: [item_id], onDelete: Cascade)

  @@map("stock_disposals")
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}
enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  LOW_STOCK
  AVAILABLE
  NOT_AVAILABLE
  OUT_OF_STOCK
  UNDER_MAINTENANCE
  EXPIRED
  IN_USED
  DISPOSED
  INACTIVE
}

enum RequestType {
  BORROW
  CONSUME
}

enum RequestStatus {
  RETURNED
  NOT_RETURNED
  CONSUMED
  PARTIALLY_CONSUMED
  CANCELLED
}

enum BodyBuilder {
  AGILA
  HILLTOP
  RBM
  DARJ
}

enum BusType {
  AIRCONDITIONED
  ORDINARY
}

enum BusStatus {
  ACTIVE
  DECOMMISSIONED
  UNDER_MAINTENANCE
}

enum BusCondition {
  BRAND_NEW
  SECOND_HAND
}

enum AcquisitionMethod {
  PURCHASED
  LEASED
  DONATED
}

enum RegistrationStatus {
  REGISTERED
  NOT_REGISTERED
  NEEDS_RENEWAL
  EXPIRED
}

enum BusSource {
  DEALERSHIP
  AUCTION
  PRIVATE_INDIVIDUAL
}

enum DisposalMethod {
  SOLD
  SCRAPPED
  DONATED
  TRANSFERRED
}

enum DisposalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}